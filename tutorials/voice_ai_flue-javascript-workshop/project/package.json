{
  "name": "sample-voice-node-learning_server",
  "private": true,
  "scripts": {
    "start": "node index.js",
    "flue:dev": "vite dev --target node --env .env --port 3000",
    "flue:build": "vite build --target node",
    "flue:run": "flue run hello-world --target node --id local-demo --payload '{\"message\":\"Say hello from my first Flue agent.\"}' --env .env"
  },
  "dependencies": {
    "@vonage/server-sdk": "^3.27.0",
    "@flue/cli": "^2.3.1",
    "@flue/runtime": "^2.3.1",
    "@flue/vite": "^2.3.1",
    "hono": "^4.13.19",
    "vite": "^8.3.8",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
  },
  "type": "module"
}
